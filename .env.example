ANTHROPIC_API_KEY=your-key-here
# TITLEPILOT_MODEL=claude-sonnet-5-5

# ---- Mapping notifications (MP01) ----
# Email: put one or more addresses here (separate with commas). Leave blank to send no email.
# TITLEPILOT_MAPPING_EMAIL=mapping@segland.com, someone@segland.com
#
# By default the email is sent from the Outlook account signed in on this PC (Outlook must be
# installed; no password needed). To send through a mail server instead, fill these in:
# TITLEPILOT_EMAIL_METHOD=smtp
# TITLEPILOT_SMTP_HOST=smtp.office365.com
# TITLEPILOT_SMTP_PORT=587
# TITLEPILOT_SMTP_USER=you@segland.com
# TITLEPILOT_SMTP_PASSWORD=your-password-or-app-password
# TITLEPILOT_EMAIL_FROM=you@segland.com
#
# Teams or Slack (optional):
# TITLEPILOT_MAPPING_WEBHOOK=https://...
# TITLEPILOT_WEBHOOK_FORMAT=slack
